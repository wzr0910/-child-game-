# ============================================
# CloudBase 配置（公共画廊数据库，仅服务端用）
# 注意：以下变量都是「服务端密钥」，不带 NEXT_PUBLIC_ 前缀，
#       不会进浏览器/前端包。在部署平台（EdgeOne）的环境变量里填，
#       不要写进代码或公开仓库。
# ============================================
# 环境 ID，形如 child-game-d4gxbdz4zce7a5c3b
CLOUDBASE_ENV_ID=child-game-d4gxbdz4zce7a5c3b
# 腾讯云 API 密钥（控制台「访问密钥」获取）
CLOUDBASE_SECRET_ID=AKIDxxxxxxxxxxxxxxxx
CLOUDBASE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# 地域，默认 ap-shanghai（你的环境域名是 *.ap-shanghai.app.tcloudbase.com）
CLOUDBASE_REGION=ap-shanghai

# ============================================
# DeepSeek API 配置（AI 大模型）
# DeepSeek 兼容 OpenAI 接口协议
# ============================================
DEEPSEEK_API_KEY=sk-xxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ============================================
# AI 生图（Step 6 再配，先留空）
# ============================================
# JIMENG_API_KEY=
# JIMENG_BASE_URL=

# ============================================
# （已废弃）Supabase —— 因 supabase.co 在中国大陆不可达，已弃用，
# 公共画廊改为走 CloudBase（见上）。
# ============================================
