# ============================================
# CloudBase 配置（公共画廊数据库，仅服务端用）
# 注意：以下变量都是「服务端密钥」，不带 NEXT_PUBLIC_ 前缀，
#       不会进浏览器/前端包。在部署平台（EdgeOne）的环境变量里填，
#       不要写进代码或公开仓库。
# ============================================
# 环境 ID，形如 child-game-d4gxbdz4zce7a5c3b
CLOUDBASE_ENV_ID=child-game-d4gxbdz4zce7a5c3b

# Publishable Key（控制台「API Key 配置」生成，anon 角色）
# 本地开发直接整段填这一个就行：
CLOUDBASE_PUBLISHABLE_KEY=your_publishable_key_here

# —— 分片写法（仅当部署平台限制单个变量长度时使用）——
# EdgeOne 环境变量单值上限 1000 字符，而 CloudBase 的 Publishable Key 可能更长，
# 存不下。这时把 key 按顺序切成几段，分别填到下面这些变量里，
# 服务端会自动按 _1 → _2 → _3 的顺序拼接还原。
#   规则：① 从 _1 开始连续编号，不能跳号（遇到缺号就停止拼接）
#         ② 切分点不要多加/漏掉任何字符，也不要引入空格和换行
#         ③ 若 CLOUDBASE_PUBLISHABLE_KEY（整段）有值，则优先用它，忽略分片
# CLOUDBASE_PUBLISHABLE_KEY_1=
# CLOUDBASE_PUBLISHABLE_KEY_2=
# CLOUDBASE_PUBLISHABLE_KEY_3=
#
# 配完后自检：浏览器打开 你的网址/api/gallery?debug=1
#   会返回 key 长度、是否是完整 JWT、上游 CloudBase 的真实响应（不含密钥明文）

# ============================================
# DeepSeek API 配置（AI 大模型）
# DeepSeek 兼容 OpenAI 接口协议
# ============================================
DEEPSEEK_API_KEY=sk-xxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

